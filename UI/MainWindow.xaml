<Window x:Class="RadialConvert.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open Tangerine"
        Height="700" Width="840"
        MinHeight="600" MinWidth="750"
        WindowStartupLocation="CenterScreen"
        Background="#18181F"
        Foreground="#E2E8F0">

    <Window.Resources>
        <Style x:Key="TangerineButton" TargetType="Button">
            <Setter Property="Background" Value="#252530" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="BorderBrush" Value="#38384A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#323242" />
                    <Setter Property="BorderBrush" Value="#4C4C64" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ConvertActionButton" TargetType="Button">
            <Setter Property="Background" Value="#FF610A" />
            <Setter Property="Foreground" Value="#101010" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="24,12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF7B2D" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#4A3428" />
                    <Setter Property="Foreground" Value="#808080" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="*" />    <!-- Workspace (Wheel + Drop list) -->
            <RowDefinition Height="Auto" /> <!-- Options & Actions -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Open Tangerine"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="#FF762B" />
            <TextBlock Text="Drop your files. Choose an output. Keep working."
                       FontSize="13"
                       Foreground="#94A3B8"
                       Margin="0,4,0,2" />
            <TextBlock Text="Local processing · Originals kept · Shift+Right-Click files in Explorer anytime"
                       FontSize="11.5"
                       Foreground="#64748B" />
        </StackPanel>

        <!-- Workspace: Embedded Glass Wheel (left) + File Drop Zone (right) -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Embedded Interactive Wheel -->
            <Canvas x:Name="EmbeddedWheelCanvas"
                    Grid.Column="0"
                    Width="360" Height="360"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <!-- Outer rim -->
                <Ellipse Width="346" Height="346" Canvas.Left="7" Canvas.Top="7" StrokeThickness="1">
                    <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0.05,0.01" EndPoint="0.95,0.99">
                            <GradientStop Color="#AAF8FDFF" Offset="0.0" />
                            <GradientStop Color="#55A1B8C6" Offset="0.55" />
                            <GradientStop Color="#85F5FAFF" Offset="1.0" />
                        </LinearGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.Stroke>
                        <SolidColorBrush Color="#66FFFFFF" />
                    </Ellipse.Stroke>
                </Ellipse>

                <!-- Slices Container -->
                <Canvas x:Name="EmbeddedSlices" Width="360" Height="360" />

                <!-- Center Hub -->
                <Ellipse Width="120" Height="120" Canvas.Left="120" Canvas.Top="120" StrokeThickness="1">
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.5,0.5" RadiusX="0.55" RadiusY="0.55">
                            <GradientStop Color="#F8FFFFFF" Offset="0.0" />
                            <GradientStop Color="#C8D9EAF3" Offset="1.0" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.Stroke>
                        <SolidColorBrush Color="#D0FFFFFF" />
                    </Ellipse.Stroke>
                </Ellipse>

                <Border Width="90" Height="38" Canvas.Left="135" Canvas.Top="161"
                        CornerRadius="19" Background="#A5FFFFFF" BorderBrush="#D5FFFFFF" BorderThickness="1">
                    <TextBlock x:Name="EmbeddedHubText" Text="PNG" FontSize="12" FontWeight="Bold" Foreground="#FF610A"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Canvas>

            <!-- File Drop List Area -->
            <Border x:Name="DropContainer"
                    Grid.Column="1"
                    Margin="16,0,0,0"
                    Background="#1E1E26"
                    BorderBrush="#38384A"
                    BorderThickness="2"
                    CornerRadius="12"
                    AllowDrop="True"
                    DragEnter="DropContainer_DragEnter"
                    DragLeave="DropContainer_DragLeave"
                    Drop="DropContainer_Drop">
                <Grid>
                    <!-- Empty State Prompt -->
                    <StackPanel x:Name="EmptyPrompt"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Visible">
                        <TextBlock Text="📁" FontSize="36" HorizontalAlignment="Center" />
                        <TextBlock Text="Drag and drop files here"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#CBD5E1"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,4" />
                        <TextBlock Text="Images (WebP, PNG, JPG, BMP), PDFs, or Subtitles"
                                   FontSize="11.5"
                                   Foreground="#64748B"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Items List -->
                    <ListBox x:Name="FilesListBox"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="#E2E8F0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Visibility="Collapsed">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Ready" FontSize="11" Foreground="#10B981" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- Controls & Convert Button -->
        <StackPanel Grid.Row="2">
            <!-- File actions row -->
            <DockPanel LastChildFill="False" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Add files…" Style="{StaticResource TangerineButton}" Click="AddFiles_Click" Margin="0,0,8,0" />
                    <Button Content="Clear" Style="{StaticResource TangerineButton}" Click="ClearFiles_Click" />
                </StackPanel>

                <Button x:Name="OutputFolderButton"
                        DockPanel.Dock="Right"
                        Content="Save beside originals"
                        Style="{StaticResource TangerineButton}"
                        Click="OutputFolder_Click" />
            </DockPanel>

            <!-- Operation Selector & Progress -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Convert to:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,10,0" />

                <ComboBox x:Name="OperationsCombo"
                          Grid.Column="1"
                          Height="34"
                          Background="#252530"
                          Foreground="#E2E8F0"
                          FontSize="12"
                          SelectionChanged="OperationsCombo_SelectionChanged" />

                <Button x:Name="ConvertButton"
                        Grid.Column="2"
                        Margin="12,0,0,0"
                        Content="Convert files"
                        Style="{StaticResource ConvertActionButton}"
                        Click="Convert_Click" />
            </Grid>

            <!-- Status / Progress Bar -->
            <ProgressBar x:Name="JobProgressBar" Height="4" Background="#252530" Foreground="#FF610A" BorderThickness="0" Visibility="Collapsed" />
            <TextBlock x:Name="StatusMessage" Text="" FontSize="11.5" Foreground="#10B981" HorizontalAlignment="Right" />
        </StackPanel>
    </Grid>
</Window>
