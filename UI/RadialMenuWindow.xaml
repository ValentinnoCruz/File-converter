<Window x:Class="RadialConvert.UI.RadialMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="O-Tangerine Glass Wheel"
        Height="310" Width="270"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="True"
        ResizeMode="NoResize"
        AllowDrop="True">

    <Window.Resources>
        <!-- Soft realistic frosted glass shadow -->
        <DropShadowEffect x:Key="GlassShadow"
                          BlurRadius="20"
                          ShadowDepth="3"
                          Direction="270"
                          Color="#081824"
                          Opacity="0.40" />

        <DropShadowEffect x:Key="TextGlow"
                          BlurRadius="6"
                          ShadowDepth="1"
                          Direction="270"
                          Color="#FF3B00"
                          Opacity="0.8" />
    </Window.Resources>

    <Grid x:Name="RootGrid" Width="270" Height="310" AllowDrop="True">
        <!-- Wheel Container (270x270) -->
        <Canvas x:Name="WheelCanvas" Width="270" Height="270" HorizontalAlignment="Center" VerticalAlignment="Top" Effect="{StaticResource GlassShadow}" AllowDrop="True">
            <!-- Pearly Frosted Rim Ellipse -->
            <Ellipse x:Name="PearlyRim" Width="238" Height="238" Canvas.Left="16" Canvas.Top="16" StrokeThickness="1">
                <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="0.05,0.01" EndPoint="0.95,0.99">
                        <GradientStop Color="#85FFFFFF" Offset="0.0" />
                        <GradientStop Color="#40A0C4DA" Offset="0.55" />
                        <GradientStop Color="#75FFFFFF" Offset="1.0" />
                    </LinearGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Stroke>
                    <SolidColorBrush Color="#88FFFFFF" />
                </Ellipse.Stroke>
            </Ellipse>

            <!-- Slices added dynamically -->
            <Canvas x:Name="SlicesContainer" Width="270" Height="270" AllowDrop="True" />

            <!-- Center Glass Hub (84x84 at 93,93) -->
            <Ellipse x:Name="CenterHub" Width="84" Height="84" Canvas.Left="93" Canvas.Top="93" StrokeThickness="1.2">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.45,0.4" RadiusX="0.55" RadiusY="0.55">
                        <GradientStop Color="#F8FFFFFF" Offset="0.0" />
                        <GradientStop Color="#C0D4E6F2" Offset="1.0" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Stroke>
                    <SolidColorBrush Color="#B8FFFFFF" />
                </Ellipse.Stroke>
            </Ellipse>

            <!-- Inner Hub Pill (64x26 at 103, 122) -->
            <Border x:Name="HubPill"
                    Width="64" Height="26"
                    Canvas.Left="103" Canvas.Top="122"
                    CornerRadius="13"
                    Background="#88FFFFFF"
                    BorderBrush="#B8FFFFFF"
                    BorderThickness="1">
                <TextBlock x:Name="HubText"
                           Text="DROP"
                           FontSize="10.5"
                           FontWeight="Bold"
                           Foreground="#263D4A"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
        </Canvas>

        <!-- Top Source File / Selection Pill -->
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,6,0,0"
                Background="#E6F6FAFD"
                BorderBrush="#99FFFFFF"
                BorderThickness="1"
                CornerRadius="11"
                Padding="10,3"
                Effect="{StaticResource GlassShadow}">
            <TextBlock x:Name="FileNameText"
                       Text="file.webp"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="#28404E"
                       MaxWidth="210"
                       TextTrimming="CharacterEllipsis"
                       HorizontalAlignment="Center" />
        </Border>

        <!-- Floating Caption Pill below the wheel -->
        <Border x:Name="CaptionPill"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,6"
                Width="230" Height="26"
                CornerRadius="13"
                Background="#E8EFF8FD"
                BorderBrush="#B0FFFFFF"
                BorderThickness="1"
                Effect="{StaticResource GlassShadow}">
            <TextBlock x:Name="CaptionText"
                       Text="Drop onto format to convert"
                       FontSize="10.5"
                       FontWeight="SemiBold"
                       Foreground="#28404E"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>
