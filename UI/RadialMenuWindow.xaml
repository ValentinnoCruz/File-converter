<Window x:Class="RadialConvert.UI.RadialMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickConvert Wheel"
        Height="360" Width="360"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="True"
        ResizeMode="NoResize">
    
    <Window.Resources>
        <!-- Smooth drop shadow effect -->
        <DropShadowEffect x:Key="WheelShadow"
                          BlurRadius="28"
                          ShadowDepth="4"
                          Direction="270"
                          Color="#000000"
                          Opacity="0.65" />
    </Window.Resources>

    <Grid x:Name="RootGrid" Width="360" Height="360">
        <!-- Wheel Container -->
        <Canvas x:Name="SlicesCanvas" Width="360" Height="360" Effect="{StaticResource WheelShadow}">
            <!-- Slices added dynamically in code-behind -->
        </Canvas>

        <!-- Center Hub (Neutral / Cancel Zone) -->
        <Grid x:Name="CenterHub"
              Width="96" Height="96"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
            
            <Ellipse x:Name="CenterEllipse"
                     Fill="#1C1C24"
                     Stroke="#38384A"
                     StrokeThickness="2" />

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="CenterIcon"
                           Text="✕"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#9CA3AF"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="CenterText"
                           Text="Cancel"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#9CA3AF"
                           HorizontalAlignment="Center"
                           Margin="0,2,0,0" />
            </StackPanel>
        </Grid>

        <!-- Top Tooltip / Info Badge (Source File) -->
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,8,0,0"
                Background="#D916161E"
                BorderBrush="#38384A"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12,5"
                Effect="{StaticResource WheelShadow}">
            <TextBlock x:Name="FileNameText"
                       Text="file.webp"
                       FontSize="11"
                       FontWeight="Medium"
                       Foreground="#E2E8F0"
                       MaxWidth="260"
                       TextTrimming="CharacterEllipsis"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Status Notification Overlay (e.g. "Converting...") -->
        <Border x:Name="StatusBadge"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,10"
                Background="#E610B981"
                CornerRadius="10"
                Padding="14,6"
                Visibility="Collapsed">
            <TextBlock x:Name="StatusText"
                       Text="Converting to PNG..."
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#FFFFFF" />
        </Border>
    </Grid>
</Window>
